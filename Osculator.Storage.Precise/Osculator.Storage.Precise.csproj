<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one alias package whose storage type comes from a package rather than a C# keyword,
         so it carries a PackageReference the other three do not. -->
    <!-- This carried PrivateAssets="all" until Semantics 5.5.1. The alias packages shipped a
         buildTransitive props file, so a project referencing two or more facades inherited two
         or more full sets of global usings and failed with hundreds of CS1537 alias collisions,
         far from the cause. ktsu-dev/Semantics#244 fixed that upstream and the guard is now
         redundant: with it removed, Osculator.Tests references all four facades and still sees
         no alias at all, which is the behaviour the guard existed to produce. Verified rather
         than assumed, and removed so nothing here describes a bug that no longer exists. -->
    <PackageReference Include="ktsu.Semantics.Quantities.Precise" />
    <!-- The quantity types themselves. The alias package supplies only the global usings that
         bind them to one storage type, so the types arrive transitively and must be referenced. -->
    <PackageReference Include="ktsu.Semantics.Quantities" />
    <PackageReference Include="ktsu.PreciseNumber" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Osculator.Core\Osculator.Core.csproj" />
    <ProjectReference Include="..\Osculator.Numerics.Precise\Osculator.Numerics.Precise.csproj" />
  </ItemGroup>
</Project>

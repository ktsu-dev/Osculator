<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The open generics, not an alias package. The alias packages bind every quantity to one
         storage type project-wide, and this project is generic over all of them. -->
    <PackageReference Include="ktsu.Semantics.Quantities" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- EGM96 to degree 70, read by Egm96.Load. Bundled because a force model that needs a network
         or a file path to construct is not one a test or an offline run can use. -->
    <EmbeddedResource Include="Forces\Data\egm96-to70.txt" LogicalName="ktsu.Osculator.Core.Forces.Data.egm96-to70.txt" />
  </ItemGroup>
</Project>

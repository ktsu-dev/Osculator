<Project>
  <Sdk Name="MSTest.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <RootNamespace>ktsu.Osculator.Tests</RootNamespace>
    <AssemblyName>$(RootNamespace)</AssemblyName>
    <EnableSourceLink>false</EnableSourceLink>
    <!-- The gallery loads the application font through ImGui calls that take pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SGP4 verification vectors. Committed rather than fetched: the suite is worthless if it
         only runs with a network, and the files are small and stable. -->
    <None Update="Data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The application shell's tests. -->
    <PackageReference Include="ktsu.ImGui.App" />
    <PackageReference Include="ktsu.ImGui.App.Testing" />
    <PackageReference Include="ktsu.ImGui.Widgets" />
    <PackageReference Include="ktsu.Invoker" />
    <PackageReference Include="Hexa.NET.ImGui" />
    <PackageReference Include="Hexa.NET.ImGui.Widgets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Osculator.Core\Osculator.Core.csproj" />
    <ProjectReference Include="..\Osculator.Data\Osculator.Data.csproj" />
    <ProjectReference Include="..\Osculator.App\Osculator.App.csproj" />
    <ProjectReference Include="..\Osculator.Storage.Double\Osculator.Storage.Double.csproj" />
    <ProjectReference Include="..\Osculator.Storage.Float\Osculator.Storage.Float.csproj" />
    <ProjectReference Include="..\Osculator.Storage.Decimal\Osculator.Storage.Decimal.csproj" />
    <ProjectReference Include="..\Osculator.Storage.Precise\Osculator.Storage.Precise.csproj" />
  </ItemGroup>
</Project>
